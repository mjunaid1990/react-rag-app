# Admin panel URL is same-origin through the Vite API proxy.
VITE_RAG_API_URL=/api/chat

# Server-only values. Copy this file to .env and set real values there.
# Use a long, unique password. Admin access is disabled until this is set.
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=8787
DATABASE_PATH=./server/data/rag-chat.sqlite
PUBLIC_API_URL=

# Optional OpenAI-compatible chat completion service.
# Leave RAG_API_KEY empty to use extractive answers from matching knowledge articles.
RAG_API_URL=https://api.openai.com/v1/chat/completions
RAG_API_KEY=
RAG_MODEL=gpt-4o-mini
RAG_PROVIDER_LABEL=OpenAI-compatible
